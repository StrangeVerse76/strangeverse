{
  "name": "@strangeverse/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Database (Neon Postgres): schema Drizzle, migrazioni e client",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "@strangeverse/config": "workspace:*",
    "@types/node": "24.19.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
