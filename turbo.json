{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".nuxt/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "passThroughEnv": ["PLAYWRIGHT_BASE_URL", "PLAYWRIGHT_CHANNEL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
