{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "prepare:types": {
      "dependsOn": ["^prepare:types"],
      "outputs": [".nuxt/**"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "DATABASE_URL_UNPOOLED"]
    },
    "build": {
      "dependsOn": ["^build", "^prepare:types", "^db:migrate", "typecheck", "test"],
      "outputs": ["dist/**", ".output/**", ".nuxt/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^prepare:types", "prepare:types"]
    },
    "test": {
      "dependsOn": ["^prepare:types", "prepare:types"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "passThroughEnv": ["PLAYWRIGHT_BASE_URL", "PLAYWRIGHT_CHANNEL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
